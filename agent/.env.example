# Переменные сервисов agent и mcp. Секретов здесь нет — скопируйте в .env и подставьте ключ.

# --- LLM (любой OpenAI-совместимый API) ---
# mock   — детерминированный LLM на правилах, работает без ключа и сети.
# openai — реальная модель по LLM_BASE_URL / LLM_MODEL / LLM_API_KEY.
# Если LLM_API_KEY пуст, агент сам включает mock и пишет об этом в лог.
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=

# --- Адреса сервисов (значения для docker compose) ---
API_BASE_URL=http://api:8080
MCP_URL=http://mcp:8082
REDIS_URL=redis://redis:6379/0
AGENT_ADDR=:8081
MCP_ADDR=:8082

# Часовой пояс для «сегодня», «завтра», «в пятницу»
TZ=Europe/Moscow
# Разрешённый Origin фронтенда (* — любой)
CORS_ORIGINS=*

# --- Лимиты (значения по умолчанию) ---
AGENT_MAX_TOOL_CALLS=5
AGENT_TIMEOUT_SEC=30
LLM_TIMEOUT_SEC=20
TOOL_TIMEOUT_SEC=5
AGENT_HISTORY_LIMIT=10
AGENT_MAX_MESSAGE_LEN=2000
AGENT_RATE_LIMIT=20
AGENT_RATE_WINDOW_SEC=60
AGENT_PENDING_TTL_SEC=1800
